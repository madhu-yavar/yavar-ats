{
  "manifest_version": 3,
  "name": "ATSIQ Capture",
  "version": "1.0.0",
  "description": "Send the job description or CV you are looking at straight into ATSIQ.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost:8080/*", "https://atsiq.yavar.ai/*", "https://yavar-ats.lovable.app/*"],
  "action": { "default_popup": "popup.html", "default_title": "ATSIQ Capture" }
}
