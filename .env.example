# Local secrets template — copy to .env.local (gitignored) and fill in.
# Never put these in .env: that file IS committed and must stay public-only.
#
# .env (committed)  -> public values only: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, VITE_*
# .env.local (local) -> everything secret, listed below

# --- Required for server functions locally (bypasses RLS; get from Lovable Cloud panel) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Optional: LinkedIn one-time connect (panel shows "being set up" without these) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Override only if the app is not served from its public origin:
# LINKEDIN_REDIRECT_ORIGIN=https://atsiq.yavar.ai

# --- Optional: raises GitHub API rate limit for social scoring ---
GITHUB_TOKEN=
