# Local development template — copy to .env and fill in.
# .env is gitignored: real secrets live ONLY there, never in committed files.
#
# Public Supabase values are already committed in .env.production (safe by design:
# the publishable key is meant to be public). You only need to add the secret here.

# --- Required for the app to boot locally (server-side, bypasses RLS) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Optional: LinkedIn one-time connect (the panel shows "being set up" without these) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Override only if the app is not served from its public origin:
# LINKEDIN_REDIRECT_ORIGIN=https://atsiq.yavar.ai

# --- Optional: raises GitHub API rate limit for social scoring ---
GITHUB_TOKEN=
